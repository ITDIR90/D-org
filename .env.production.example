# Production environment configuration for D-org
# Copy to .env and fill in all required values

# Application
APP_NAME="Digital-органайзер"
APP_SHORT_NAME="D-органайзер"
APP_TAGLINE="единый центр задач, проектов и коммуникаций"
APP_ENV="production"

# SECURITY - REQUIRED: Set a strong random secret (min 32 chars)
# Generate with: openssl rand -hex 32
SECRET_KEY=""

# JWT token expiration in minutes (default: 30)
JWT_EXPIRE_MINUTES=30

# Database
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://helpdesk:changeme@db:5432/helpdesk"

# CORS - Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="https://yourdomain.com,https://admin.yourdomain.com"

# Email / SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS=true
EMAIL_ENABLED=false

# AI (optional) - at least one provider key required if AI_ENABLED=true
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_BASE_URL=""
AI_PROVIDER="auto"  # auto | openai | gemini
AI_ENABLED=false
AI_MODEL=""

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ENABLED=false

# MAX (optional)
MAX_ENABLED=false
MAX_GATEWAY_URL=""
MAX_GATEWAY_TOKEN=""

# Push Notifications (optional)
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=""

# Default superadmin credentials - REQUIRED in production
DEFAULT_SUPERADMIN_EMAIL="admin@yourdomain.com"
DEFAULT_SUPERADMIN_PASSWORD=""  # Must be set - no default!

# Duplicate detection windows
DUPLICATE_MESSAGE_WINDOW_SECONDS=30
DUPLICATE_TASK_WINDOW_SECONDS=60

# Integration API (optional)
INTEGRATION_API_ENABLED=false
INTEGRATION_API_KEY=""
INTEGRATION_USER_ID=0

# File uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10